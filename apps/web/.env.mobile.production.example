# Copy to .env.mobile.production and set your public server (no trailing slash).
# Same URL you open in the browser — API is at /api/v1 on the same host.
#
# Example VPS:
VITE_MOBILE=true
VITE_API_ORIGIN=http://5.83.140.179
# Optional: direct APK download URL for the install prompt (defaults to /gachify.apk on same host)
# VITE_APK_URL=https://gachify.ru/gachify.apk
