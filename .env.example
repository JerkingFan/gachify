# API
GACHIFY_ENV=development
GACHIFY_HTTP_ADDR=:8080

# PostgreSQL
GACHIFY_DATABASE_URL=postgres://gachify:gachify@localhost:5432/gachify?sslmode=disable

# Redis (queue, cache, rate limits, recent plays, token blacklist)
GACHIFY_REDIS_URL=redis://localhost:6379/0

# Auth (min 32 chars)
GACHIFY_JWT_SECRET=dev-only-change-in-production-min-32-chars!!
GACHIFY_JWT_ACCESS_TTL=15m
GACHIFY_JWT_REFRESH_TTL=168h

# Object storage (MinIO local)
GACHIFY_S3_ENDPOINT=http://localhost:9000
GACHIFY_S3_PUBLIC_ENDPOINT=http://localhost:9000
GACHIFY_S3_BUCKET_MASTERS=gachify-masters
GACHIFY_S3_ACCESS_KEY=gachify
GACHIFY_S3_SECRET_KEY=gachifysecret
GACHIFY_S3_PATH_STYLE=true

# Streaming (signed HLS playlists)
GACHIFY_PLAYBACK_TOKEN_TTL=5m
GACHIFY_PLAYBACK_SEGMENT_TTL=2m
GACHIFY_PUBLIC_API_URL=http://localhost:8080

# OIDC Google (optional)
# GACHIFY_GOOGLE_CLIENT_ID=
# GACHIFY_GOOGLE_CLIENT_SECRET=
# GACHIFY_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/google/callback
# GACHIFY_FRONTEND_URL=http://localhost:5173

# Moderation (transcode -> pending_review before published)
# GACHIFY_MODERATION_ENABLED=true
# GACHIFY_ADMIN_SECRET=change-me-admin-key

# CDN / production streaming (presigned URLs rewritten to CDN origin)
# GACHIFY_CDN_BASE_URL=https://cdn.yourdomain.com
# GACHIFY_S3_PUBLIC_ENDPOINT=https://cdn.yourdomain.com
# GACHIFY_HLS_SEGMENT_PRESIGN_TTL=24h

# Worker scaling (docker compose prod)
# GACHIFY_WORKER_REPLICAS=2

# Rate limiting (Redis-backed; set GACHIFY_RATE_LIMIT_ENABLED=false to disable)
# GACHIFY_RATE_LIMIT_AUTH_LOGIN=10
# GACHIFY_RATE_LIMIT_AUTH_REGISTER=5
# GACHIFY_RATE_LIMIT_UPLOAD_INIT=20
# GACHIFY_RATE_LIMIT_SEARCH=60

# Transcode worker retries & scaling
# GACHIFY_TRANSCODE_MAX_ATTEMPTS=3
# GACHIFY_TRANSCODE_RETRY_BASE=30s
# GACHIFY_TRANSCODE_VISIBILITY_TIMEOUT=30m
# GACHIFY_WORKER_SHUTDOWN_TIMEOUT=2m

# Redis-backed response cache (tracks/search lists)
# GACHIFY_CACHE_ENABLED=true
# GACHIFY_CACHE_TTL=30s

# Observability
# GACHIFY_METRICS_ENABLED=true
# GACHIFY_SENTRY_DSN=
# Optional stack: deploy/docker-compose.monitoring.yml (Prometheus + Grafana dashboard + alerts)

# Production email (GACHIFY_ENV=production uses SMTP; development logs to stdout)
# GACHIFY_SMTP_HOST=smtp.example.com
# GACHIFY_SMTP_PORT=587
# GACHIFY_SMTP_USER=
# GACHIFY_SMTP_PASSWORD=
# GACHIFY_SMTP_FROM=noreply@example.com

# Admin UI: http://localhost/admin (moderation + DLQ)

# Seed writes (required in production; optional in development — env=development allows without key)
# GACHIFY_SEED_SECRET=dev-only-seed-secret
