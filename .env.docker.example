# Copy to .env in project root:  copy .env.docker.example .env
# Used by: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# --- Published ports (Caddy) ---
GACHIFY_HTTP_PORT=80
GACHIFY_HTTPS_PORT=443
# Public hostname for automatic HTTPS (use your domain; keep localhost for local Docker)
GACHIFY_DOMAIN=localhost
ACME_EMAIL=you@example.com

# --- Published ports ---
# MinIO host port (optional; uploads/HLS use Caddy :80 proxy — browsers need not reach :9000)
GACHIFY_MINIO_PORT=9000

# --- Postgres / MinIO credentials (change in production) ---
POSTGRES_USER=gachify
POSTGRES_PASSWORD=gachify
POSTGRES_DB=gachify
MINIO_ROOT_USER=gachify
MINIO_ROOT_PASSWORD=gachifysecret

# --- App ---
GACHIFY_ENV=production
GACHIFY_JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long
# Required for Docker seed service (POST /internal/seed/* in production)
GACHIFY_SEED_SECRET=change-me-to-a-random-seed-secret

# Public URL as seen by the browser (no trailing slash)
GACHIFY_PUBLIC_API_URL=http://localhost
GACHIFY_CORS_ORIGINS=http://localhost
# Presigned upload/HLS URLs — same origin as the site (Caddy proxies /gachify-* to MinIO)
GACHIFY_S3_PUBLIC_ENDPOINT=http://localhost
GACHIFY_FRONTEND_URL=http://localhost

# Moderation admin UI (/admin) and internal API
GACHIFY_ADMIN_SECRET=change-me-admin-key
GACHIFY_MODERATION_ENABLED=true

# Production email (required when GACHIFY_ENV=production)
# GACHIFY_SMTP_HOST=smtp.example.com
# GACHIFY_SMTP_PORT=587
# GACHIFY_SMTP_USER=
# GACHIFY_SMTP_PASSWORD=
# GACHIFY_SMTP_FROM=noreply@yourdomain.com

# Optional monitoring: deploy/docker-compose.monitoring.yml
# GRAFANA_ADMIN_PASSWORD=change-me
